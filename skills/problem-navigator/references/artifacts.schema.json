{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:problem-navigator:artifacts",
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\r\\n]+$"
    },
    "string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "blocking_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "task_ids"],
      "properties": {
        "code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "task_ids": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "operation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search", "fetch", "map"],
      "properties": {
        "search": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "fetch": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "map": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem_frame": {
          "$ref": "#/$defs/relative_path"
        },
        "research_brief": {
          "$ref": "#/$defs/relative_path"
        },
        "evidence_draft": {
          "$ref": "#/$defs/relative_path"
        },
        "evidence_package": {
          "$ref": "#/$defs/relative_path"
        },
        "readiness_pack": {
          "$ref": "#/$defs/relative_path"
        },
        "decision": {
          "$ref": "#/$defs/relative_path"
        },
        "refined_solution": {
          "$ref": "#/$defs/relative_path"
        },
        "solution_document": {
          "$ref": "#/$defs/relative_path"
        },
        "solution_spec_package": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow_id",
        "next_stage",
        "selected_backend",
        "native_fallback_approved",
        "research_state",
        "call_counts",
        "artifact_refs"
      ],
      "properties": {
        "research_reservations": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/non_empty_string"},
          "additionalProperties": {"$ref": "#/$defs/research_reservation"}
        },
        "schema_version": {
          "const": 1
        },
        "workflow_id": {
          "$ref": "#/$defs/workflow_id"
        },
        "analysis_goal": {
          "enum": ["UNDERSTAND", "DECIDE"]
        },
        "next_stage": {
          "enum": [
            "problem-framing",
            "research-design-kickoff",
            "research-execution",
            "decision-readiness-interview",
            "adversarial-option-selection",
            "solution-refinement",
            "solution-documentation",
            "solution-decomposition",
            "DONE",
            "STOPPED"
          ]
        },
        "selected_backend": {
          "enum": ["NONE", "UNSET", "RESEARCH_CORE", "HOST_NATIVE"]
        },
        "native_fallback_approved": {
          "type": "boolean"
        },
        "research_state": {
          "enum": [
            "NOT_STARTED",
            "RESEARCH_IN_PROGRESS",
            "RESEARCH_COMPLETE",
            "RESEARCH_PARTIAL",
            "RESEARCH_BLOCKED",
            "RESEARCH_FAILED",
            "RESEARCH_CANCELLED"
          ]
        },
        "blocking_reason": {
          "$ref": "#/$defs/blocking_reason"
        },
        "call_counts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/non_empty_string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/operation_counts"
          }
        },
        "research_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "recovery_reserve"],
          "properties": {
            "limit": {"type": "integer", "minimum": 1},
            "recovery_reserve": {"type": "integer", "minimum": 0}
          }
        },
        "artifact_refs": {
          "$ref": "#/$defs/artifact_refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selected_backend": {
                "enum": ["NONE", "UNSET", "RESEARCH_CORE"]
              }
            },
            "required": ["selected_backend"]
          },
          "then": {
            "properties": {
              "native_fallback_approved": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selected_backend": {
                "const": "HOST_NATIVE"
              }
            },
            "required": ["selected_backend"]
          },
          "then": {
            "properties": {
              "native_fallback_approved": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "next_stage": {
                "enum": [
                  "research-design-kickoff",
                  "research-execution",
                  "decision-readiness-interview",
                  "adversarial-option-selection",
                  "solution-refinement",
                  "solution-documentation",
                  "solution-decomposition",
                  "DONE"
                ]
              }
            },
            "required": ["next_stage"]
          },
          "then": {
            "required": ["analysis_goal"]
          }
        },
        {
          "if": {
            "properties": {
              "research_state": {
                "enum": [
                  "RESEARCH_IN_PROGRESS",
                  "RESEARCH_COMPLETE",
                  "RESEARCH_PARTIAL",
                  "RESEARCH_FAILED",
                  "RESEARCH_CANCELLED"
                ]
              }
            },
            "required": ["research_state"]
          },
          "then": {
            "required": ["analysis_goal"]
          }
        },
        {
          "if": {
            "properties": {
              "next_stage": {
                "enum": [
                  "decision-readiness-interview",
                  "adversarial-option-selection",
                  "solution-refinement",
                  "solution-documentation",
                  "solution-decomposition"
                ]
              }
            },
            "required": ["next_stage"]
          },
          "then": {
            "properties": {
              "analysis_goal": {
                "const": "DECIDE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "next_stage": {
                "const": "STOPPED"
              }
            },
            "required": ["next_stage"]
          },
          "then": {
            "required": ["blocking_reason"]
          }
        },
        {
          "if": {
            "properties": {
              "research_state": {
                "const": "RESEARCH_BLOCKED"
              }
            },
            "required": ["research_state"]
          },
          "then": {
            "required": ["blocking_reason"]
          }
        },
        {
          "if": {
            "required": ["blocking_reason"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "research_state": {
                    "const": "RESEARCH_BLOCKED"
                  }
                },
                "required": ["research_state"]
              },
              {
                "properties": {
                  "next_stage": {
                    "const": "STOPPED"
                  }
                },
                "required": ["next_stage"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "research_state": {
                "const": "NOT_STARTED"
              }
            },
            "required": ["research_state"]
          },
          "then": {
            "properties": {
              "next_stage": {
                "enum": [
                  "problem-framing",
                  "research-design-kickoff",
                  "research-execution",
                  "STOPPED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "research_state": {
                "const": "RESEARCH_IN_PROGRESS"
              }
            },
            "required": ["research_state"]
          },
          "then": {
            "properties": {
              "next_stage": {
                "enum": [
                  "research-design-kickoff",
                  "research-execution",
                  "STOPPED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "research_state": {
                "const": "RESEARCH_BLOCKED"
              }
            },
            "required": ["research_state"]
          },
          "then": {
            "properties": {
              "next_stage": {
                "enum": ["problem-framing", "research-execution", "STOPPED"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "research_state": {
                "enum": ["RESEARCH_FAILED", "RESEARCH_CANCELLED"]
              }
            },
            "required": ["research_state"]
          },
          "then": {
            "properties": {
              "next_stage": {
                "const": "STOPPED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "research_state": {
                "enum": ["RESEARCH_COMPLETE", "RESEARCH_PARTIAL"]
              }
            },
            "required": ["research_state"]
          },
          "then": {
            "properties": {
              "next_stage": {
                "enum": [
                  "research-design-kickoff",
                  "decision-readiness-interview",
                  "adversarial-option-selection",
                  "solution-refinement",
                  "solution-documentation",
                  "solution-decomposition",
                  "DONE",
                  "STOPPED"
                ]
              }
            }
          }
        }
      ]
    },
    "problem_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow_id",
        "problem_frame_id",
        "problem_frame_version",
        "analysis_goal",
        "content_profile",
        "clarified_problem",
        "goal",
        "scope",
        "non_goals",
        "constraints",
        "assumptions",
        "delivery_endpoint",
        "user_confirmation_status"
      ],
      "properties": {
        "court_required": {"type": "boolean"},
        "schema_version": {
          "const": 1
        },
        "workflow_id": {
          "$ref": "#/$defs/workflow_id"
        },
        "problem_frame_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "problem_frame_version": {
          "$ref": "#/$defs/positive_integer"
        },
        "analysis_goal": {
          "enum": ["UNDERSTAND", "DECIDE"]
        },
        "content_profile": {
          "enum": ["GENERAL", "PRODUCT_SOFTWARE"]
        },
        "clarified_problem": {
          "$ref": "#/$defs/non_empty_string"
        },
        "goal": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope": {
          "$ref": "#/$defs/string_list"
        },
        "non_goals": {
          "$ref": "#/$defs/string_list"
        },
        "constraints": {
          "$ref": "#/$defs/string_list"
        },
        "assumptions": {
          "$ref": "#/$defs/string_list"
        },
        "delivery_endpoint": {
          "$ref": "#/$defs/non_empty_string"
        },
        "user_confirmation_status": {
          "enum": ["DRAFT", "ACCEPTED"]
        },
        "confirmation_basis": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "research_reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "operation", "attempt_id", "ordinal"],
      "properties": {
        "task_id": {"$ref": "#/$defs/non_empty_string"},
        "operation": {"enum": ["search", "fetch", "map"]},
        "attempt_id": {"$ref": "#/$defs/non_empty_string"},
        "ordinal": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "research_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_coverage"],
      "properties": {
        "product_context": {"$ref": "#/$defs/non_empty_string"},
        "theme_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme_id", "treatment", "rationale", "task_ids"],
            "properties": {
              "theme_id": {"$ref": "#/$defs/non_empty_string"},
              "treatment": {"enum": ["RESEARCH", "MERGED", "NOT_APPLICABLE"]},
              "rationale": {"$ref": "#/$defs/non_empty_string"},
              "task_ids": {"$ref": "#/$defs/string_list"}
            }
          }
        }
      }
    },
    "provided_material_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "theme_id",
        "question",
        "task_kind",
        "material_refs",
        "quality_bar",
        "stop_condition"
      ],
      "properties": {
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "expected_output": {"$ref": "#/$defs/non_empty_string"},
        "depends_on": {"$ref": "#/$defs/string_list"},
        "task_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "theme_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "question": {
          "$ref": "#/$defs/non_empty_string"
        },
        "task_kind": {
          "const": "PROVIDED_MATERIAL"
        },
        "supplemental_request_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "material_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "uniqueItems": true
        },
        "quality_bar": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stop_condition": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "public_web_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "theme_id",
        "question",
        "task_kind",
        "direction",
        "domains",
        "freshness",
        "quality_bar",
        "stop_condition"
      ],
      "properties": {
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "expected_output": {"$ref": "#/$defs/non_empty_string"},
        "depends_on": {"$ref": "#/$defs/string_list"},
        "task_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "theme_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "question": {
          "$ref": "#/$defs/non_empty_string"
        },
        "task_kind": {
          "const": "PUBLIC_WEB"
        },
        "supplemental_request_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "direction": {
          "enum": ["auto", "news", "semantic", "academic", "developer"]
        },
        "domains": {
          "$ref": "#/$defs/string_list"
        },
        "freshness": {
          "enum": ["", "day", "week", "month", "year"]
        },
        "quality_bar": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stop_condition": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "research_task": {
      "oneOf": [
        {
          "$ref": "#/$defs/provided_material_task"
        },
        {
          "$ref": "#/$defs/public_web_task"
        }
      ]
    },
    "research_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workflow_id", "problem_frame_id", "problem_frame_version", "revision", "analysis_goal", "tasks"],
      "properties": {
        "design": {"$ref": "#/$defs/research_design"},
        "problem_frame_id": {"$ref": "#/$defs/non_empty_string"},
        "problem_frame_version": {"$ref": "#/$defs/positive_integer"},
        "schema_version": {
          "const": 1
        },
        "workflow_id": {
          "$ref": "#/$defs/workflow_id"
        },
        "revision": {
          "$ref": "#/$defs/positive_integer"
        },
        "analysis_goal": {
          "enum": ["UNDERSTAND", "DECIDE"]
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/research_task"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"required": ["design"]},
          "then": {
            "properties": {
              "tasks": {"items": {"required": ["purpose", "expected_output", "depends_on"]}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "revision": {
                "const": 1
              }
            },
            "required": ["revision"]
          },
          "then": {
            "properties": {
              "tasks": {
                "maxItems": 12,
                "items": {
                  "not": {
                    "required": ["supplemental_request_id"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "name", "definition"],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "definition": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "outcome",
        "quality_met",
        "call_refs",
        "source_ids",
        "external_source_ids"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "outcome": {
          "enum": ["WITH_RESULTS", "NO_RESULTS", "FAILED", "NOT_RUN"]
        },
        "quality_met": {
          "type": "boolean"
        },
        "call_refs": {
          "$ref": "#/$defs/string_list"
        },
        "source_ids": {
          "$ref": "#/$defs/string_list"
        },
        "external_source_ids": {
          "$ref": "#/$defs/string_list"
        },
        "error_code": {
          "enum": [
            "INVALID_REQUEST",
            "NOT_CONFIGURED",
            "AUTH_FAILED",
            "RATE_LIMITED",
            "QUOTA_EXHAUSTED",
            "NETWORK_ERROR",
            "PROVIDER_ERROR"
          ]
        },
        "not_run_reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "fallback_authorization": {
          "const": "USER_APPROVED"
        },
        "fallback_reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": ["NO_RESULTS", "FAILED", "NOT_RUN"]
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "quality_met": {
                "const": false
              }
            }
          }
        },
        {
          "dependentRequired": {
            "fallback_authorization": ["fallback_reason"],
            "fallback_reason": ["fallback_authorization"]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "WITH_RESULTS"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "source_ids": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "external_source_ids": {
                    "minItems": 1
                  }
                }
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": ["error_code"]
                },
                {
                  "required": ["not_run_reason"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "FAILED"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "required": ["error_code"],
            "not": {
              "required": ["not_run_reason"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "NOT_RUN"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "required": ["not_run_reason"],
            "not": {
              "required": ["error_code"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "NO_RESULTS"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["error_code"]
                },
                {
                  "required": ["not_run_reason"]
                }
              ]
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "call_ref",
        "title",
        "normalized_url",
        "provider",
        "source_type",
        "retrieved_at"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "call_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "normalized_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "provider": {
          "enum": ["brave", "exa", "firecrawl", "host_native"]
        },
        "source_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "anyOf": [{"format": "date"}, {"format": "date-time"}]
        },
        "query_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "content_kind": {
          "enum": ["search_excerpt", "page_excerpt", "full_page", "document_observation"]
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_item_id",
        "task_id",
        "kind",
        "statement",
        "web_source_ids",
        "external_source_ids"
      ],
      "properties": {
        "critical": {"type": "boolean"},
        "basis_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
        "evidence_item_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "task_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_ids": {
          "$ref": "#/$defs/string_list"
        },
        "kind": {
          "enum": ["FACT", "INFERENCE", "ASSUMPTION", "UNKNOWN"]
        },
        "statement": {
          "$ref": "#/$defs/non_empty_string"
        },
        "web_source_ids": {
          "$ref": "#/$defs/string_list"
        },
        "external_source_ids": {
          "$ref": "#/$defs/string_list"
        },
        "passage_locator": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "INFERENCE"}}, "required": ["kind"]},
          "then": {"required": ["basis_evidence_ids"]},
          "else": {"not": {"required": ["basis_evidence_ids"]}}
        },
        {
          "if": {"properties": {"kind": {"const": "FACT"}, "critical": {"const": true}}, "required": ["kind", "critical"]},
          "then": {"required": ["passage_locator"], "properties": {"passage_locator": {"type": "string", "pattern": "\\S"}}}
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "FACT"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "web_source_ids": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "external_source_ids": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ]
    },
