                    "const": "01-prd.md"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          },
          {
            "properties": {
              "members": {
                "type": "array",
                "prefixItems": [
                  {
                    "const": "01-prd.md"
                  },
                  {
                    "const": "02-technical-solution-spec.md"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
